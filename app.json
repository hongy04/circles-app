{
  "expo": {
    "name": "my-app",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F3FAFF"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "Circles uses your contacts to find mutual connections. You can exclude any contact.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "circles.ios"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_CONTACTS"
      ],
      "package": "circles.android"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-notifications"
    ],
    "scheme": "circles",
    "extra": {
      "eas": {
        "projectId": "5fd8c774-47b0-44b2-8250-6012b74a231b"
      }
    },
    "owner": "hongy29"
  }
}
