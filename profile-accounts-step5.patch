+    lineHeight: 17,
+    marginTop: 2,
+  },
+  destructiveText: {
+    color: '#b42318',
+  },
+  separator: {
+    height: StyleSheet.hairlineWidth,
+    backgroundColor: COLORS.border,
+    marginLeft: 62,
+  },
+  footerText: {
