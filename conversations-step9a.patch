+          mine ? styles.mineBubble : styles.otherBubble,
+        ]}>
+          <Text style={[
+            styles.messageText,
+            mine ? styles.mineText : styles.otherText,
+          ]}>
+            {item.body}
+          </Text>
+        </View>
+        <Text style={[
+          styles.messageTime,
+          mine ? styles.mineTime : styles.otherTime,
+        ]}>
+          {formatTime(item.createdAt)}
+        </Text>
+      </View>
+    );
+  };
+
+  if (!conversationId) {
