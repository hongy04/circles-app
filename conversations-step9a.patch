+        >
+          <View style={[
+            styles.composer,
+            { paddingBottom: Math.max(8, insets.bottom) },
+          ]}>
+            <View style={styles.inputWrap}>
+              <TextInput
+                value={input}
+                onChangeText={setInput}
+                placeholder="Message"
+                placeholderTextColor="#9e9e9e"
+                multiline
+                maxLength={4000}
