+          <Ionicons
+            name={post.liked ? 'heart' : 'heart-outline'}
+            size={27}
+            color={post.liked ? '#e11d48' : COLORS.text}
+          />
+        </Pressable>
+        <Pressable onPress={onOpenPost} hitSlop={10} style={styles.actionButton}>
